# Evently — copy this file to ".env" and change every value marked CHANGE.

# Images to run (registry and version published by the Evently team)
EVENTLY_REGISTRY=evently
EVENTLY_VERSION=latest

# Public address of the site and port on this machine
SITE_URL=http://localhost
HTTP_PORT=80

# Random secret (CHANGE) — e.g. the output of: openssl rand -hex 16
APP_SECRET=change-me

# Database (CHANGE the passwords)
DB_NAME=evently
DB_USER=evently
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
